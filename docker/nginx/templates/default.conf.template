# Lives at the http level, outside the server block: "upgrade" while the client asks for
# it, "close" otherwise — an ordinary request should not be offered a protocol change.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The day of the request for the access file name. A new file starts every day, so the
# files need no logrotate; logs:clean deletes the old ones.
map $time_iso8601 $log_date {
    "~^(?<d>\d{4}-\d{2}-\d{2})" $d;
    default                       today;
}

server {
    listen 80;
    listen [::]:80;

    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    # Matches SCONCUR_HTTP_MAX_REQUEST_BODY, the app refuses more anyway.
    client_max_body_size 10M;

    # Nothing is served from disk, but an access_log path with variables is written only
    # while the request's root exists, and the default one (/etc/nginx/html) does not.
    root /usr/share/nginx/html;

    # The folder is ./storage/logs/nginx on the host, read by the Logs page.
    access_log /var/log/nginx/app/access-$log_date.log combined;
    open_log_file_cache max=4;

    # error_log takes no variables, so this is one file without rotation.
    error_log /var/log/nginx/app/error.log warn;

    # Docker's embedded DNS. Needed because the upstream is resolved per request
    # (see below) rather than once at startup.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        # The host goes through a variable on purpose. An `upstream` block — or a
        # literal name here — is resolved once when the config loads and cached for
        # the life of the process, so recreating the workers container hands it a
        # new IP and nginx keeps dialling the old one until it is restarted. With a
        # variable, nginx resolves per request and follows the container.
        #
        # The trade-off is the upstream keepalive pool, which only works with an
        # `upstream` block. On a local bridge network at this request rate that
        # costs far less than 502s after every container recreation.
        set $sconcur workers:${SCONCUR_HTTP_PORT};

        proxy_pass http://$sconcur;

        # 1.0 is the default and cannot carry a chunked response — the trace tree
        # endpoint streams one.
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Trace aggregations and tree building can outlive the 60s default.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # The ws pool. Its own block rather than a branch of the one above: an upgraded
    # connection is meant to live for hours, and the 300s there would cut every client
    # several times an hour.
    #
    # The path has to match SCONCUR_WS_PATH_PREFIX — the app key follows it, and the
    # extension compares the path before PHP sees the request.
    location /app/ {
        # Resolved per request, for the same reason as above.
        set $sconcur_ws workers:${SCONCUR_WS_PORT};

        proxy_pass http://$sconcur_ws;

        proxy_http_version 1.1;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
