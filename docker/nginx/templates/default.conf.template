server {
    listen 80;
    listen [::]:80;

    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    client_max_body_size 100M;

    # Docker's embedded DNS. Needed because the upstream is resolved per request
    # (see below) rather than once at startup.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        # The host goes through a variable on purpose. An `upstream` block — or a
        # literal name here — is resolved once when the config loads and cached for
        # the life of the process, so recreating the workers container hands it a
        # new IP and nginx keeps dialling the old one until it is restarted. With a
        # variable, nginx resolves per request and follows the container.
        #
        # The trade-off is the upstream keepalive pool, which only works with an
        # `upstream` block. On a local bridge network at this request rate that
        # costs far less than 502s after every container recreation.
        set $sconcur workers:${SCONCUR_HTTP_PORT};

        proxy_pass http://$sconcur;

        # 1.0 is the default and cannot carry a chunked response — the trace tree
        # endpoint streams one.
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Trace aggregations and tree building can outlive the 60s default.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
