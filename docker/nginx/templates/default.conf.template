upstream sconcur {
    server workers:${SCONCUR_HTTP_PORT};

    # Reuse connections to the worker instead of opening one per request.
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;

    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    client_max_body_size 100M;

    location / {
        proxy_pass http://sconcur;

        # nginx proxies with HTTP/1.0 by default, which disables upstream keepalive.
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Trace aggregations and tree building can outlive the 60s default.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
