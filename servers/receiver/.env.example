# buffer documents the transporter takes per pass, at most the rows of one ClickHouse insert
TRANSPORTER_BATCH_SIZE=5000

# clickhouse: the traces themselves
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=slogger
CLICKHOUSE_USERNAME=slogger
CLICKHOUSE_PASSWORD=_sl_password_3125

# logging
LOG_DIR=storage/logs
# any,debug,info,warn,error
LOG_LEVELS=any
LOG_KEEP_DAYS=3
