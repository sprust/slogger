# mongodb
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_USERNAME=sl_admin
MONGODB_PASSWORD=_sl_password_3124
MONGODB_DB_TRACES=traces
MONGODB_COLL_BUFFER=buffer
MONGODB_COLL_INVALID_BUFFER=invalidBuffer
MONGODB_COLL_WATCHER_TIMELINES=watcherTimelines
MONGODB_COLL_TRACE_METRICS=traceMetrics
