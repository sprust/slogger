parameters:
    paths:
        - ../app
        - ../packages/sconcur

    excludePaths:
        - ../app/Console/Commands/Local
        - ../app/Models

    level: 8

    ignoreErrors:
        # The sconcur-laravel package overrides Laravel contracts whose own
        # signatures are untyped (Repository::set, Translator::get, Container::build,
        # ...). Overriding them faithfully means inheriting their untyped arrays and
        # their loose container types, so these say nothing about the package's own
        # correctness. Incompatible declarations are NOT among them: catching those
        # is why the package is analysed at all.
        -
            identifier: missingType.iterableValue
            path: ../packages/sconcur/*
        -
            identifiers:
                - cast.string
                - nullsafe.neverNull
                - argument.type
                - argument.templateType
                - method.nonObject

            path: ../packages/sconcur/*
        -
            message: '#Call to an undefined method Illuminate\\Contracts\\Foundation\\Application::forgetInstance\(\)#'
            path: ../packages/sconcur/sconcur-laravel/src/SConcurServiceProvider.php
        -
            message: '#Unsafe usage of new static#'
        -
            message: '#Access to an undefined property MongoDB\\Model\\BSONDocument#'
        -
            messages:
                - '#Property [\s\S]* is never read, only written#'
                - '#Property [\s\S]* type has no value type specified in iterable type array#'

            path: "*Resource.php"
        -
            message: '#return type has no value type specified in iterable type array#'
            path: "*Request.php"
        -
            messages:
                - '#Parameter \#1 \$callback of method Illuminate\\Support\\Collection<int\,stdClass\>::map\(\) expects callable\(stdClass\, int\)#'
