# nginx in front of the sconcur http workers; the port is .env -> APP_PORT
BACKEND_URL=http://localhost:8097
VITE_BACKEND_URL=${BACKEND_URL}
APP_NAME="SLogger: local"
VITE_APP_NAME=${APP_NAME}

# The public half of the ws pool's credentials — root .env -> SCONCUR_WS_APP_KEY. It is
# part of the upgrade path (/app/{key}), so the browser has to carry it; the secret that
# signs subscriptions never leaves the backend. Empty here means the panel falls back to
# polling; changing it means rebuilding the panel, since it is baked into the bundle.
SCONCUR_WS_KEY=
VITE_SCONCUR_WS_KEY=${SCONCUR_WS_KEY}
