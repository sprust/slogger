# Committed test-only settings. No developer .env values or production credentials.
APP_NAME=slogger-test
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost
APP_CONFIG_CACHE=storage/framework/testing/config.php
APP_ROUTES_CACHE=storage/framework/testing/routes.php
APP_EVENTS_CACHE=storage/framework/testing/events.php
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=4

DB_CONNECTION=sconcur_mysql
DATABASE_URL=null
DB_SOCKET=
DB_HOST=test-mysql
DB_PORT=3306
DB_DATABASE=slogger_test
DB_USERNAME=root
DB_PASSWORD=testing
SCONCUR_DB_MAX_OPEN_CONNS=5

MONGO_HOST=test-mongo
MONGO_PORT=27017
MONGO_DATABASE_ADMIN=admin
MONGO_DATABASE_TRACES=traces_test
MONGO_ADMIN_USERNAME=root
MONGO_ADMIN_PASSWORD=testing

CLICKHOUSE_HOST=test-clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=slogger_test
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=testing
CLICKHOUSE_TIMEOUT_SECONDS=60

CACHE_DRIVER=array
MUTEX_CACHE_STORE=array
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_DRIVER=log
QUEUE_CONNECTION=sync
QUEUE_TRACES_CLEANER_CONNECTION=sync
QUEUE_TRACE_TREE_CONNECTION=sync
SLOGGER_DISPATCHER_QUEUE_CONNECTION=sync
SLOGGER_ENABLED=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
SCONCUR_FILESYSTEM_FILES=false
MCP_SERVER_NAME=
REDIS_CLIENT=sconcur
REDIS_USERNAME=null
REDIS_HOST=test-redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_URL=null
REDIS_DB=0
REDIS_CACHE_DB=1
